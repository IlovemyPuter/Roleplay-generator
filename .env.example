# gemini | openrouter | ollama (default: gemini)
LLM_PROVIDER=gemini        

# Podaj swój klucz API z Google AI Studio (https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=""
# Podaj preferowany model Gemini (np. gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"  

OPENROUTER_API_KEY=
OPENROUTER_MODEL=    

OLLAMA_MODEL="gemma4:e4b"
OLLAMA_BASE_URL=http://localhost:11434/v1   
LLM_TIMEOUT_MS=                         