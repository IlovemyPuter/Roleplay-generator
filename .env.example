LLM_PROVIDER=gemini        # gemini | openrouter | ollama (default: gemini)

GEMINI_API_KEY=""         # Podaj swój klucz API z Google AI Studio (https://aistudio.google.com/app/api-keys)
GEMINI_MODEL="gemini-3.5-flash-lite"  # Podaj preferowany model Gemini (np. gemini-3.5-flash-lite)

OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""       # e.g. a model id from openrouter.ai/models

OLLAMA_MODEL="gemma4:e4b"
OLLAMA_BASE_URL=http://localhost:11434/v1   # optional
LLM_TIMEOUT_MS=3000                          # optional